---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Page title="blog · warren yun" description="writing">
	<a class="back" href="/">Home ←</a>
	<h1>warren's wonderful writings</h1>
	{
		posts.length ? (
			<ul>
				{posts.map((post) => (
					<li>
						<time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
						<div>
							{post.data.url ? (
								<a href={post.data.url} target="_blank" rel="noopener noreferrer">
									{post.data.title}<span class="out" aria-label="(external)">↗</span>
								</a>
							) : (
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							)}
							{post.data.description && <p class="desc">{post.data.description}</p>}
						</div>
						{post.data.draft && <span class="draft">draft</span>}
					</li>
				))}
			</ul>
		) : (
			<p class="empty">nothing here yet.</p>
		)
	}
</Page>

<style>
	.back {
		font-size: 1rem;
		color: var(--fg4);
	}
	.back:hover {
		color: var(--fg2);
	}
	h1 {
		margin-top: 0.5rem;
		font-size: 1.875rem;
		color: var(--fg1);
	}
	ul {
		margin-top: 2rem;
	}
	li {
		display: grid;
		grid-template-columns: 7rem 1fr auto;
		gap: 1rem;
		align-items: baseline;
	}
	li + li {
		margin-top: 1rem;
	}
	time,
	.draft,
	.empty {
		font-size: 0.95rem;
		color: var(--fg4);
		font-variant-numeric: tabular-nums;
	}
	li a {
		color: var(--green);
		text-decoration-line: underline;
	}
	.desc {
		margin-top: 0.15rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--fg4);
	}
	.out {
		margin-left: 0.25rem;
		font-size: 0.85em;
		color: var(--fg4);
		text-decoration-line: none;
		display: inline-block;
	}
	.empty {
		margin-top: 2rem;
	}

	@media (max-width: 640px) {
		li {
			grid-template-columns: 1fr auto;
			gap: 0 1rem;
		}
		time {
			grid-column: 1 / -1;
		}
	}
</style>
