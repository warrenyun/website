---
import Page from "../layouts/Page.astro";
import NowPlaying from "../components/NowPlaying.astro";
import Favorites from "../components/Favorites.astro";
import Reel from "../components/Reel.astro";
import GpgKey from "../components/GpgKey.astro";

const friends: [string, string][] = [
	["Ashray", "https://www.ashray.sh/"],
	["Asa", "https://anglesideangle.dev/"],
	["Joey", "https://jlruan.me/"],
	["Rohan", "https://www.rohankalia.dev/"],
	["Divij", "https://www.divij.vc/"],
];
---

<Page title="yo, i'm warren" description="i'm a wildcard">
	<a class="to-blog" href="/blog/" slot="after">blog</a>
	<section>
		<div class="socials">
			<a
				href="https://github.com/warrenyun"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					fill="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						fill-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
						clip-rule="evenodd"></path>
				</svg>
			</a>
			<a
				href="https://x.com/warrenyun_"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					fill="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path>
				</svg>
			</a>
			<a
				href="https://www.linkedin.com/in/warren-yun/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					fill="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
					></path>
				</svg>
			</a>
		</div>
		<h1>warren yun</h1>
		<p>
			Hi. I like to make things and solve cool problems!
		</p>
		<p>
				  Right now, I'm leading software for <a
					href="https://hytechracing.gatech.edu/"
					class="link yellow"
					target="_blank"
					rel="noopener noreferrer">Georgia Tech's Formula SAE Electric team</a>. We're building our first driverless racecar for the 2027 FSAE autonomous cup!

		I tend to hop from one interest to another (<span class="blue">web development</span>, <span class="blue">embedded security</span>, <span class="blue">mobile networking</span>.. blah blah), but I've always loved <span class="green">autonomous robots</span>, and more recently, <span class="green">machine learning</span>!
		</p>
		<p>
			I love meeting people doing cool things! If this is you, please reach out at 
			<code class="email">wyun2006 [at] gmail [dot] com</code>!
		</p>
	</section>
	<section>
		<h2>previously i...</h2>
		<ul>
			<li>
				trained end-to-end driving models at
				 <a
					href="https://comma.ai/"
					target="_blank"
					rel="noopener noreferrer"
					class="link green">comma.ai</a>
			</li>
			<li>
				worked on flight reliability software for <a
					href="https://www.spacex.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="link green">SpaceX</a>
			</li>
			<li>
				expanded coverage for millions of
				 <a
					href="https://starlink.com/business/mobile"
					target="_blank"
					rel="noopener noreferrer"
					class="link green">Starlink Mobile</a>
					users
			</li>
			<li>
				spent a year flying around the country to "win" <a
					href="https://devpost.com/software/talktuahbank"
					target="_blank"
					rel="noopener noreferrer"
					class="link green">hackathons</a
				>
			</li>


		</ul>
		<Reel />
	</section>
	<section>
		<h2>some assorted favorites</h2>
		<Favorites />
	</section>
	{
		friends.length > 0 && (
			<section>
				<h2>lovely people i've worked with</h2>
				<ul>
					{friends.map(([name, href]) => (
						<li>
							<a class="link green" href={href} target="_blank" rel="noopener noreferrer">{name}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	<GpgKey />
	<NowPlaying slot="after" />
</Page>

<style>
	h1 {
		font-size: 1.875rem;
		color: var(--fg1);
	}
	h2 {
		font-size: 1.125rem;
	}
	ul {
		padding-left: 1.15rem;
		list-style-type: disc;
	}

	/* main (from the Page layout) and the previous sibling (maybe a component) are global here */
	:global(main) > :global(*) + * {
		margin-top: 2.5rem;
	}
	section > * + * {
		margin-top: 0.85rem;
	}
	h1 + p {
		margin-top: 1.25rem;
	}
	li + li {
		margin-top: 0.35rem;
	}

	/* sits where the theme toggle used to */
	.to-blog {
		position: fixed;
		top: 1.25rem;
		right: 1.5rem;
		font-size: 1rem;
		color: var(--fg4);
		transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
	}
	.to-blog:hover {
		color: var(--fg2);
	}

	.link {
		text-decoration-line: underline;
	}
	.yellow {
		color: var(--yellow);
	}
	.green {
		color: var(--green);
	}
	.blue {
		color: var(--blue);
	}

	.socials {
		display: flex;
		gap: 0.75rem;
	}
	.socials + h1 {
		margin-top: 0.75rem;
	}
	.socials a {
		color: var(--fg4);
		transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
	}
	.socials a:hover {
		color: var(--fg2);
	}
	.socials svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.email {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--bg2);
		border-radius: 0.25rem;
		background-color: var(--bg1);
		color: var(--fg2);
		font-size: 0.9em;
		/* wrap to the next line as one piece rather than mid-address */
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		li {
			font-size: 1rem;
		}
	}
</style>
