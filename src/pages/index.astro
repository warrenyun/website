	<GpgKey />
	<NowPlaying slot="after" />
</Page>

<style>
	h1 {
		font-size: 1.875rem;
		color: var(--fg1);
	}
	h2 {
		font-size: 1.125rem;
	}
	ul {
		padding-left: 1.15rem;
		list-style-type: disc;
	}

	/* main (from the Page layout) and the previous sibling (maybe a component) are global here */
	:global(main) > :global(*) + * {
		margin-top: 2.5rem;
	}
	section > * + * {
		margin-top: 0.85rem;
	}
	h1 + p {
		margin-top: 1.25rem;
	}
	li + li {
		margin-top: 0.35rem;
	}

	/* sits where the theme toggle used to */
	.to-blog {
		position: fixed;
		top: 1.25rem;
		right: 1.5rem;
		font-size: 1rem;
		color: var(--fg4);
		transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
	}
	.to-blog:hover {
		color: var(--fg2);
	}

	.link {
		text-decoration-line: underline;
	}
	.yellow {
		color: var(--yellow);
	}
	.green {
		color: var(--green);
	}
	.blue {
		color: var(--blue);
	}

	/* the live counter: the email chip's box, in yellow, in the body font */
	#since {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--bg2);
		border-radius: 0.25rem;
		background-color: var(--bg1);
		color: var(--yellow);
		/* fixed-width digits so the line doesn't shift every second */
		font-variant-numeric: tabular-nums;
		text-decoration-line: underline;
		text-decoration-style: dotted;
		text-underline-offset: 0.2em;
		/* it's long, so let it wrap on phones but keep each line's border and padding */
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.address {
		text-decoration-line: underline;
		text-decoration-style: dotted;
		text-underline-offset: 0.2em;
	}
	/* fixed so it can't be clipped; the script places it under the address */
	.map-card {
		position: fixed;
		z-index: 30;
		display: block;
		width: 300px;
		padding: 0.4rem;
		border: 1px solid var(--bg2);
		border-radius: 0.6rem;
		background: var(--bg1);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition:
			opacity 150ms ease,
			transform 150ms ease,
			visibility 150ms;
	}
	.place.open .map-card {
		opacity: 1;
		visibility: visible;
		transform: none;
	}
	.map-frame {
		display: block;
		height: 190px;
		overflow: hidden;
		border-radius: 0.4rem;
		background: var(--bg2);
	}
	.map-frame :global(iframe) {
		width: 100%;
		height: 100%;
		border: 0;
	}
	.map-label {
		display: block;
		padding: 0.35rem 0.2rem 0.1rem;
		font-size: 0.8rem;
		line-height: 1.3;
		color: var(--fg4);
	}

	.socials {
		display: flex;
		gap: 0.75rem;
	}
	.socials + h1 {
		margin-top: 0.75rem;
	}
	.socials a {
		color: var(--fg4);
		transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
	}
	.socials a:hover {
		color: var(--fg2);
	}
	.socials svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.email {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--bg2);
		border-radius: 0.25rem;
		background-color: var(--bg1);
		color: var(--fg2);
		font-size: 0.9em;
		/* wrap to the next line as one piece rather than mid-address */
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		li {
			font-size: 1rem;
		}
	}
</style>

<script>
	// a) live "for the past ..." counter
	const START = Date.UTC(2020, 3, 13, 22, 32); // 6:32pm eastern (edt) on april 13, 2020
	const since = document.getElementById("since");
	const plural = (n: number, unit: string) => `${n} ${unit}${n === 1 ? "" : "s"}`;
	const tick = () => {
		const now = new Date();
		// whole years by calendar anniversary, the rest broken down from there
		let years = now.getUTCFullYear() - 2020;
		const anniversary = new Date(START);
		anniversary.setUTCFullYear(2020 + years);
		if (anniversary > now) anniversary.setUTCFullYear(2020 + --years);
		let s = Math.floor((now.getTime() - anniversary.getTime()) / 1000);
		const days = Math.floor(s / 86400);
		const hours = Math.floor((s %= 86400) / 3600);
		const minutes = Math.floor((s %= 3600) / 60);
		const seconds = s % 60;
		since!.textContent = [
			plural(years, "year"),
			plural(days, "day"),
			plural(hours, "hour"),
			plural(minutes, "minute"),
			plural(seconds, "second"),
		].join(", ");
	};
	tick();
	setInterval(tick, 1000);

	// b) hovering the address shows a little map; it only loads the first time
	const place = document.querySelector<HTMLElement>(".place")!;
	const card = place.querySelector<HTMLElement>(".map-card")!;
	let hideTimer = 0;
	const open = () => {
		clearTimeout(hideTimer);
		const frame = card.querySelector(".map-frame")!;
		if (!frame.firstChild) {
			const map = document.createElement("iframe");
			map.src = "https://maps.google.com/maps?q=Georgia+Tech+Student+Competition+Center,+575+14th+St+NW,+Atlanta,+GA+30318&z=16&output=embed";
			map.title = "Georgia Tech Student Competition Center on Google Maps";
			map.loading = "lazy";
			frame.append(map);
		}
		// under the address (above it if there's no room), kept on screen
		const r = place.querySelector(".address")!.getBoundingClientRect();
		const w = card.offsetWidth, h = card.offsetHeight;
		card.style.left = `${Math.max(12, Math.min(r.left, innerWidth - w - 12))}px`;
		card.style.top = `${r.bottom + 8 + h > innerHeight ? r.top - h - 8 : r.bottom + 8}px`;
		place.classList.add("open");
	};
	// a short delay lets the cursor cross the gap into the card
	const close = () => (hideTimer = window.setTimeout(() => place.classList.remove("open"), 150));
	place.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && open());
	place.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && close());
	addEventListener("scroll", () => place.classList.remove("open"), { passive: true });
</script>
