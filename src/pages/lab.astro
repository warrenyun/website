---
// scratch page for trying out ways to attach clips to the homepage.
// delete once one of them graduates into index.astro.
import BaseHead from "../components/BaseHead.astro";
import Media from "../components/Clip.astro";

type Media = { src: string; poster: string };
const v = (name: string): Media => ({ src: `/media/${name}.mp4`, poster: `/media/${name}.jpg` });

const clips: Record<string, { caption: string; media: Media[] }> = {
	dv: { caption: "hytech dv, first autonomous laps", media: [v("dv-car"), v("dv-viz")] },
	robotics: { caption: "1155, from the robot's point of view", media: [v("robotics")] },
	comma: { caption: "driving model + the office car", media: [v("comma")] },
};

const items: { pre: string; link: string; href: string; post: string; clip?: string }[] = [
	{ pre: "led a ", link: "competitive robotics team", href: "https://www.youtube.com/watch?v=Q2C3_wkqsVw", post: " in high school", clip: "robotics" },
	{ pre: "spent a year flying around the country to win ", link: "hackathons", href: "https://devpost.com/software/talktuahbank", post: "" },
	{ pre: "worked on flight reliability software for ", link: "SpaceX", href: "https://www.spacex.com/", post: "" },
	{ pre: "expanded coverage for millions of ", link: "Starlink Mobile", href: "https://starlink.com/business/mobile", post: " users" },
	{ pre: "trained end-to-end driving models at ", link: "comma.ai", href: "https://comma.ai/", post: "", clip: "comma" },
];

const variants = [
	["peek", "hover a link, a clip floats by the cursor"],
	["reveal", "a tiny ▸ expands the clip inline"],
	["margin", "clip appears in the side gutter, like a sidenote"],
	["strip", "a quiet row of tiles under the list"],
	["chip", "a thumbnail the size of a word sits after the link; hover or tap to blow it up"],
	["ascii", "hover a link, the clip plays as gruvbox ascii"],
	["backdrop", "hover a link and the clip washes in behind the page, very faint (on phones: scroll)"],
	["theater", "▸ dims the page and plays the clip centered, esc to leave"],
	["monitor", "a little screen in the corner, sibling to now-playing (on phones: scroll)"],
	["bullet", "the bullets for items with clips are tiny videos; hover the row"],
	["bento", "everything at once: a mosaic under the list, all playing; hover one to focus, click to enlarge"],
	["marquee", "everything at once: a full-width strip drifting slowly sideways; hover to pause"],
	["wall", "everything at once: a wall of little monitors with live timecodes"],
];

// the collection views. `area` places a tile in the bento grid.
const reel: { name: string; label: string; area: string; ratio: string }[] = [
	{ name: "dv-car", label: "hytech dv", area: "a", ratio: "16/9" },
	{ name: "comma", label: "comma model", area: "b", ratio: "1/1" },
	{ name: "robotics", label: "1155", area: "c", ratio: "16/9" },
	{ name: "dv-viz", label: "dv planner", area: "d", ratio: "16/9" },
	{ name: "robotics-arm", label: "1155 arm", area: "f", ratio: "9/16" },
	{ name: "period", label: "period", area: "g", ratio: "8/9" },
];
const reelMedia = (r: (typeof reel)[number]): Media => v(r.name);
const poster = (key: string) => clips[key].media[0].poster;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title="lab" description="clip experiments" />
		<meta name="robots" content="noindex" />
		<style is:global>
			:root {
				--bg: #282828;
				--bg1: #3c3836;
				--bg2: #504945;
				--fg: #ebdbb2;
				--fg1: #fbf1c7;
				--muted: #a89984;
				--yellow: #f6c657;
				--green: #8ec07c;
			}
			html {
				background: var(--bg);
				color: var(--fg);
			}
			body {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				min-height: 100vh;
				padding: 6rem 1.5rem 4rem;
			}
			main,
			p,
			h1,
			h2,
			ul {
				margin: 0;
				padding: 0;
			}
			h1 {
				font-size: 1.875rem;
				color: var(--fg1);
			}
			h2 {
				font-size: 1.125rem;
				color: var(--fg1);
			}
			ul {
				padding-left: 1.15rem;
				list-style-type: disc;
			}
			main {
				width: 100%;
				max-width: 42rem;
				font-size: 1.125rem;
				line-height: 1.625;
			}
			.underline {
				text-decoration-line: underline;
			}
			main > * + * {
				margin-top: 2.5rem;
			}
			section > * + * {
				margin-top: 0.85rem;
			}
			li + li {
				margin-top: 0.35rem;
			}
			a.y {
				color: var(--yellow);
			}
			a.g {
				color: var(--green);
			}

			.tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1.25rem;
				font-size: 1rem;
				color: var(--muted);
			}
			.tabs a {
				color: var(--muted);
				text-decoration: none;
			}
			.tabs a[aria-current="true"] {
				color: var(--fg1);
				text-decoration: underline;
				text-underline-offset: 0.25em;
			}
			.hint {
				font-size: 0.95rem;
				color: var(--muted);
			}
			[data-variant][hidden] {
				display: none;
			}

			/* shared media frame */
			.frame {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 6px;
				border: 1px solid var(--bg2);
				background: var(--bg1);
			}

			/* ---------- peek ---------- */
			.peek-float {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 20;
				width: 300px;
				pointer-events: none;
				opacity: 0;
				transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(0.97);
				transition:
					opacity 120ms ease,
					transform 120ms ease;
			}
			.peek-float.on {
				opacity: 1;
				transform: translate3d(var(--x, 0), var(--y, 0), 0);
			}
			.peek-float > [data-for] {
				display: none;
				gap: 0.4rem;
			}
			.peek-float > [data-for].on {
				display: grid;
			}
			.peek-float .frame {
				box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
			}

			/* ---------- reveal ---------- */
			.clip-toggle {
				margin-left: 0.35rem;
				padding: 0 0.2rem;
				border: 0;
				background: none;
				color: var(--muted);
				font: inherit;
				font-size: 0.8em;
				line-height: 1;
				cursor: pointer;
				transition:
					transform 150ms ease,
					color 150ms ease;
			}
			.clip-toggle:hover {
				color: var(--fg);
			}
			.clip-toggle[aria-expanded="true"] {
				transform: rotate(90deg);
				color: var(--fg);
			}
			.clip-panel {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 220ms ease;
			}
			.clip-panel.open {
				grid-template-rows: 1fr;
			}
			.clip-panel > figure {
				overflow: hidden;
			}
			.clip-panel .row {
				display: flex;
				gap: 0.5rem;
				padding: 0.6rem 0 0.4rem;
				max-width: 30rem;
			}
			.clip-panel .row > * {
				flex: 1 1 0;
				min-width: 0;
			}
			.clip-panel figcaption,
			.tile figcaption {
				font-size: 0.85rem;
				color: var(--muted);
			}

			/* ---------- margin ---------- */
			.margin-li {
				position: relative;
			}
			.sidenote {
				display: none;
			}
			@media (min-width: 1240px) and (hover: hover) {
				.sidenote {
					display: grid;
					gap: 0.4rem;
					position: absolute;
					top: 0.3rem;
					left: calc(100% + 2.5rem);
					width: 240px;
					opacity: 0;
					transform: translateX(-6px);
					pointer-events: none;
					transition:
						opacity 160ms ease,
						transform 160ms ease;
				}
				.margin-li:hover .sidenote,
				.margin-li:focus-within .sidenote {
					opacity: 1;
					transform: none;
				}
				/* a faint tick so the row hints that something lives beside it */
				.margin-li::after {
					content: "";
					position: absolute;
					top: 0.85em;
					left: calc(100% + 1rem);
					width: 0.6rem;
					border-top: 1px solid var(--bg2);
					transition: border-color 160ms ease;
				}
				.margin-li:hover::after {
					border-color: var(--muted);
				}
			}
			.margin-fallback {
				display: none;
			}
			@media not ((min-width: 1240px) and (hover: hover)) {
				.margin-fallback {
					display: block;
				}
			}

			/* ---------- strip ---------- */
			.strip {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.6rem;
			}
			.tile {
				margin: 0;
				cursor: pointer;
			}
			.tile .frame {
				aspect-ratio: 4 / 3;
				object-fit: cover;
				filter: grayscale(1);
				opacity: 0.55;
				transition:
					filter 200ms ease,
					opacity 200ms ease;
			}
			.tile:hover .frame,
			.tile.on .frame {
				filter: none;
				opacity: 1;
			}
			.tile figcaption {
				margin-top: 0.25rem;
				line-height: 1.3;
			}
			/* ---------- chip ---------- */
			.chip {
				display: inline-block;
				width: 1.7em;
				height: 1em;
				margin-left: 0.35rem;
				padding: 0;
				vertical-align: -0.1em;
				overflow: hidden;
				border: 1px solid var(--bg2);
				border-radius: 0.25rem;
				background: var(--bg1);
				cursor: zoom-in;
			}
			.chip img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				filter: saturate(0.4) brightness(0.85);
				transition: filter 150ms ease;
			}
			.chip:hover img,
			.chip[aria-expanded="true"] img {
				filter: none;
			}

			/* ---------- ascii ---------- */
			.ascii-float {
				width: auto;
				padding: 0.5rem;
				border: 1px solid var(--bg2);
				border-radius: 6px;
				background: var(--bg1);
				box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
			}
			.ascii-float canvas {
				display: block;
			}

			/* ---------- backdrop ---------- */
			.backdrop {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				-webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
				mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
			}
			.backdrop video {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				opacity: 0;
				filter: grayscale(0.5) blur(1.5px);
				transition: opacity 500ms ease;
			}
			.backdrop video.on {
				opacity: 0.16;
			}

			/* ---------- theater ---------- */
			dialog.theater {
				margin: auto;
				width: min(92vw, 52rem);
				max-width: none;
				padding: 0;
				border: 0;
				background: none;
				color: var(--fg);
				overflow: visible;
			}
			dialog.theater:focus {
				outline: none;
			}
			dialog.theater[open] {
				animation: rise 200ms ease;
			}
			dialog.theater::backdrop {
				background: rgb(29 32 33 / 0.86);
				backdrop-filter: blur(3px);
			}
			.theater .row {
				display: flex;
				gap: 0.6rem;
			}
			.theater .row > * {
				flex: 1 1 0;
				min-width: 0;
			}
			.theater figcaption {
				display: flex;
				justify-content: space-between;
				margin-top: 0.5rem;
				font-size: 0.9rem;
				color: var(--muted);
			}
			.theater figcaption a {
				color: var(--muted);
			}
			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(8px);
				}
			}

			/* ---------- monitor ---------- */
			.monitor {
				position: fixed;
				left: 1.25rem;
				bottom: 1.25rem;
				z-index: 30;
				width: 240px;
				padding: 0.45rem;
				border: 1px solid var(--bg2);
				border-radius: 0.75rem;
				background: var(--bg1);
				opacity: 0;
				transform: translateY(8px);
				transition:
					opacity 200ms ease,
					transform 200ms ease;
				pointer-events: none;
			}
			.monitor.on {
				opacity: 1;
				transform: none;
			}
			.monitor > [data-for] {
				display: none;
			}
			.monitor > [data-for].on {
				display: block;
			}
			.monitor .frame {
				border-radius: 0.45rem;
			}
			.monitor .label {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0 0.2rem 0.35rem;
				font-size: 0.72rem;
				line-height: 1.3;
				color: var(--muted);
			}
			.monitor .label::before {
				content: "";
				width: 0.4rem;
				height: 0.4rem;
				border-radius: 50%;
				background: var(--green);
				animation: blink 1.6s ease-in-out infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0.25;
				}
			}
			@media (max-width: 640px) {
				.monitor {
					left: 0.75rem;
					bottom: 0.75rem;
					width: 170px;
				}
			}

			/* ---------- bullet ---------- */
			.bullet-li {
				position: relative;
				list-style: none;
			}
			.bullet {
				position: absolute;
				top: 0.85em;
				right: calc(100% + 0.45rem);
				width: 0.55em;
				height: 0.55em;
				overflow: hidden;
				border-radius: 50%;
				box-shadow: 0 0 0 1px var(--bg2);
				transform: translateY(-50%);
				transition:
					width 260ms ease,
					height 260ms ease;
			}
			.bullet .frame {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border: 0;
				border-radius: 0;
			}
			.bullet-li:hover .bullet,
			.bullet-li.on .bullet {
				width: 4.25rem;
				height: 4.25rem;
			}

			/* ---------- collections (shared) ---------- */
			html {
				overflow-x: clip;
			}
			.reel-tile {
				position: relative;
				margin: 0;
				overflow: hidden;
				border-radius: 6px;
				background: var(--bg1);
				cursor: zoom-in;
				transition: opacity 250ms ease;
			}
			.reel-tile .frame {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border: 0;
				border-radius: 0;
			}
			.reel-tile figcaption {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				padding: 1.25rem 0.55rem 0.35rem;
				font-size: 0.75rem;
				line-height: 1.2;
				color: #fbf1c7;
				background: linear-gradient(transparent, rgb(29 32 33 / 0.75));
				opacity: 0;
				transition: opacity 200ms ease;
			}
			.reel-tile:hover figcaption {
				opacity: 1;
			}
			/* hovering one tile quietly steps the others back */
			.reel:hover .reel-tile:not(:hover) {
				opacity: 0.45;
			}
			@media (hover: none) {
				.reel-tile figcaption {
					opacity: 1;
				}
			}

			/* ---------- bento ---------- */
			.bento {
				display: grid;
				grid-template-columns: repeat(6, 1fr);
				grid-auto-rows: 4.6rem;
				gap: 0.45rem;
				grid-template-areas:
					"a a a a b b"
					"a a a a b b"
					"a a a a b b"
					"c c d d e e"
					"c c d d e e"
					"f f f g g g"
					"f f f g g g";
			}
			@media (max-width: 640px) {
				.bento {
					grid-template-columns: repeat(2, 1fr);
					grid-auto-rows: 4.25rem;
					grid-template-areas:
						"a a"
						"a a"
						"b c"
						"b d"
						"e d"
						"f f"
						"f f"
						"g g"
						"g g";
				}
			}

			/* ---------- marquee ---------- */
			.marquee {
				width: 100vw;
				margin-left: calc(50% - 50vw);
				overflow: hidden;
				-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
				mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
			}
			.marquee-track {
				display: flex;
				width: max-content;
				animation: drift 90s linear infinite;
			}
			.marquee:hover .marquee-track {
				animation-play-state: paused;
			}
			.marquee .reel-tile {
				flex: none;
				height: 9rem;
				margin-right: 0.5rem;
			}
			@keyframes drift {
				to {
					transform: translateX(-50%);
				}
			}
			@media (max-width: 640px) {
				.marquee .reel-tile {
					height: 6.5rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.marquee {
					overflow-x: auto;
				}
				.marquee-track {
					animation: none;
				}
			}

			/* ---------- wall ---------- */
			.wall {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.35rem;
				padding: 0.35rem;
				border: 1px solid var(--bg2);
				border-radius: 8px;
				background: #1d2021;
			}
			.wall .reel-tile {
				aspect-ratio: 4 / 3;
				border-radius: 3px;
			}
			.wall .frame {
				filter: saturate(0.75) contrast(1.05);
			}
			/* faint scanlines */
			.wall .reel-tile::after {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.12) 0 1px, transparent 1px 3px);
			}
			.wall .osd {
				position: absolute;
				top: 0.3rem;
				left: 0.4rem;
				right: 0.4rem;
				z-index: 1;
				display: flex;
				justify-content: space-between;
				font: 0.62rem/1 ui-monospace, monospace;
				letter-spacing: 0.04em;
				color: #ebdbb2;
				text-shadow: 0 1px 2px #000;
			}
			.wall .osd .rec::before {
				content: "● ";
				color: #fb4934;
				animation: blink 1.6s ease-in-out infinite;
			}
			.wall figcaption {
				font-family: ui-monospace, monospace;
				font-size: 0.65rem;
			}
			@media (max-width: 640px) {
				.wall {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			/* ---------- reel theater: one shared dialog ---------- */
			#reel-theater video,
			#reel-theater img {
				display: block;
				width: 100%;
				max-height: 80vh;
				object-fit: contain;
				border-radius: 6px;
				background: #000;
			}

			@media (max-width: 640px) {
				.strip {
					grid-template-columns: repeat(2, 1fr);
				}
				li {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<nav class="tabs" aria-label="variants">
				{variants.map(([id]) => <a href={`#${id}`} data-tab={id}>{id}</a>)}
			</nav>

			{
				variants.map(([id, hint]) => (
					<div data-variant={id} hidden>
						<p class="hint">{hint}</p>

						<section style="margin-top: 2rem">
							<h1>warren yun</h1>
							<p>
								I am also the software lead for{" "}
								<a class="underline y" href="https://hytechracing.gatech.edu/" data-clip="dv">Georgia Tech's Formula SAE Electric team</a>{id === "chip" && <button class="chip" type="button" data-chip="dv" aria-label="show clip"><img src={poster("dv")} alt="" /></button>}, building our first driverless racecar.
								{id === "reveal" && (
									<button class="clip-toggle" type="button" aria-expanded="false" data-toggle="dv" aria-label="show clip">▸</button>
								)}
								{id === "theater" && (
									<button class="clip-toggle" type="button" data-theater="dv" aria-label="play clip">▸</button>
								)}
							</p>
							{id === "reveal" && (
<div class="clip-panel" data-key={"dv"}>
								<figure style="margin: 0">
									<div class="row">
										{clips.dv.media.map((m) => <Media m={m} />)}
									</div>
									<figcaption>{clips.dv.caption}</figcaption>
								</figure>
							</div>)}
						</section>

						<section style="margin-top: 2.5rem">
							<h2>previously i...</h2>
							<ul>
								{items.map((it) => (
									<li class={it.clip && ({ margin: "margin-li", bullet: "bullet-li" } as Record<string, string>)[id]}>
										{id === "bullet" && it.clip && (
											<span class="bullet"><Media m={clips[it.clip].media[0]} /></span>
										)}
										{it.pre}
										<a class="underline g" href={it.href} target="_blank" rel="noopener noreferrer" data-clip={it.clip}>{it.link}</a>{id === "chip" && it.clip && <button class="chip" type="button" data-chip={it.clip} aria-label="show clip"><img src={poster(it.clip)} alt="" /></button>}
										{it.post}
										{id === "theater" && it.clip && (
											<button class="clip-toggle" type="button" data-theater={it.clip} aria-label="play clip">▸</button>
										)}
										{id === "reveal" && it.clip && (
											<button class="clip-toggle" type="button" aria-expanded="false" data-toggle={it.clip} aria-label="show clip">▸</button>
										)}
										{id === "reveal" && it.clip && (
<div class="clip-panel" data-key={it.clip}>
								<figure style="margin: 0">
									<div class="row">
										{clips[it.clip!].media.map((m) => <Media m={m} />)}
									</div>
									<figcaption>{clips[it.clip!].caption}</figcaption>
								</figure>
							</div>)}
										{id === "margin" && it.clip && (
											<div class="sidenote">
												{clips[it.clip].media.slice(0, 1).map((m) => <Media m={m} />)}
												<span class="hint" style="font-size: 0.8rem">{clips[it.clip].caption}</span>
											</div>
										)}
									</li>
								))}
							</ul>
						</section>

						{id === "margin" && (
							<p class="hint margin-fallback" style="margin-top: 1.5rem">
								(this one only shows on a wide screen with a mouse — narrower than 1240px it would fall back to “reveal”.)
							</p>
						)}

						{id === "bento" && (
							<div class="reel bento" data-autoplay style="margin-top: 1.75rem">
								{reel.map((r) => (
									<figure class="reel-tile" style={`grid-area: ${r.area}`} data-label={r.label}>
										<Media m={reelMedia(r)} />
										<figcaption>{r.label}</figcaption>
									</figure>
								))}
							</div>
						)}

						{id === "marquee" && (
							<div class="reel marquee" data-autoplay style="margin-top: 1.75rem">
								<div class="marquee-track">
									{/* two copies, so sliding by half loops seamlessly */}
									{[0, 1].map((copy) =>
										reel.map((r) => (
											<figure class="reel-tile" style={`aspect-ratio: ${r.ratio}`} data-label={r.label} aria-hidden={copy ? "true" : undefined}>
												<Media m={reelMedia(r)} />
												<figcaption>{r.label}</figcaption>
											</figure>
										)),
									)}
								</div>
							</div>
						)}

						{id === "wall" && (
							<div class="reel wall" data-autoplay style="margin-top: 1.75rem">
								{reel.map((r, i) => (
									<figure class="reel-tile" data-label={r.label}>
										<div class="osd">
											<span>CAM {String(i + 1).padStart(2, "0")}</span>
											<span class="rec" data-timecode>00:00</span>
										</div>
										<Media m={reelMedia(r)} />
										<figcaption>{r.label}</figcaption>
									</figure>
								))}
							</div>
						)}

						{id === "strip" && (
							<div class="strip" style="margin-top: 1.5rem">
								{[
									[clips.dv.media[0], "hytech dv"],
									[clips.dv.media[1], "dv stack"],
									[clips.robotics.media[0], "1155"],
									[clips.comma.media[0], "comma"],
								].map(([m, cap]) => (
									<figure class="tile">
										<Media m={m as Media} />
										<figcaption>{cap as string}</figcaption>
									</figure>
								))}
							</div>
						)}
					</div>
				))
			}
		</main>

		<div class="peek-float" aria-hidden="true">
			{
				Object.entries(clips).map(([key, c]) => (
					<div data-for={key}>
						{c.media.slice(0, 1).map((m) => <Media m={m} />)}
					</div>
				))
			}
		</div>

		<div
			class="peek-float ascii-float"
			aria-hidden="true"
			data-clips={JSON.stringify(Object.fromEntries(Object.entries(clips).map(([k, c]) => [k, c.media[0].src])))}
		>
			<canvas></canvas>
		</div>

		<div class="backdrop" aria-hidden="true">
			{Object.entries(clips).map(([key, c]) => (
				<video data-for={key} src={c.media[0].src} muted loop playsinline preload="none" />
			))}
		</div>

		<div class="monitor" aria-hidden="true">
			{Object.entries(clips).map(([key, c]) => (
				<div data-for={key}>
					<div class="label">{c.caption}</div>
					<Media m={c.media[0]} />
				</div>
			))}
		</div>

		<dialog class="theater" id="reel-theater">
			<figure style="margin: 0">
				<div class="stage"></div>
				<figcaption>
					<span class="cap"></span>
					<span>esc</span>
				</figcaption>
			</figure>
		</dialog>

		{Object.entries(clips).map(([key, c]) => (
			<dialog class="theater" data-for={key}>
				<figure style="margin: 0">
					<div class="row">{c.media.map((m) => <Media m={m} />)}</div>
					<figcaption>
						<span>{c.caption}</span>
						<span>esc</span>
					</figcaption>
				</figure>
			</dialog>
		))}
	</body>
</html>

<script>
	// respect reduced motion: posters only, nothing autoplays
	const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const play = (root: Element) =>
		!calm && root.querySelectorAll("video").forEach((v) => v.play().catch(() => {}));
	const stop = (root: Element) => root.querySelectorAll("video").forEach((v) => v.pause());

	// ---- tabs ----
	const show = () => {
		const id = location.hash.slice(1) || "peek";
		document.querySelectorAll<HTMLElement>("[data-variant]").forEach((el) => {
			el.hidden = el.dataset.variant !== id;
			if (el.hidden) stop(el);
		});
		document.querySelectorAll(".on:not([data-variant] *)").forEach((el) => el.classList.remove("on"));
		document.querySelectorAll(".peek-float, .backdrop, .monitor").forEach(stop);
		document.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((d) => d.close());
		document.querySelectorAll("[data-tab]").forEach((a) =>
			a.setAttribute("aria-current", String((a as HTMLElement).dataset.tab === id)),
		);
	};
	addEventListener("hashchange", show);
	show();

	// ---- shared helpers ----
	const setXY = (el: HTMLElement, x: number, y: number) => {
		el.style.setProperty("--x", `${x}px`);
		el.style.setProperty("--y", `${y}px`);
	};
	// next to the cursor, flipping above it near the bottom of the screen
	const atCursor = (el: HTMLElement, x: number, y: number) => {
		const w = el.offsetWidth, h = el.offsetHeight;
		setXY(el, Math.min(x + 18, innerWidth - w - 12), y + 18 + h > innerHeight ? y - h - 18 : y + 18);
	};
	// centered under an element, kept on screen
	const under = (el: HTMLElement, r: DOMRect) => {
		const w = el.offsetWidth, h = el.offsetHeight;
		const x = Math.max(12, Math.min(r.left + r.width / 2 - w / 2, innerWidth - w - 12));
		setXY(el, x, r.bottom + 10 + h > innerHeight - 12 ? r.top - h - 10 : r.bottom + 10);
	};
	// mouse hover over a variant's clip links
	const hover = (
		variant: string,
		enter: (key: string, e: PointerEvent) => void,
		leave: (key: string) => void,
		move?: (e: PointerEvent) => void,
	) =>
		document.querySelectorAll<HTMLElement>(`[data-variant="${variant}"] [data-clip]`).forEach((a) => {
			const key = a.dataset.clip!;
			a.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && enter(key, e));
			a.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && leave(key));
			if (move) a.addEventListener("pointermove", move);
		});
	// on touch screens there is no hover, so the item crossing the middle of the screen is "hovered"
	const touch = matchMedia("(hover: none)").matches;
	const scrolled = (variant: string, enter: (key: string) => void, leave: (key: string) => void) => {
		if (!touch) return;
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((en) => {
					const key = (en.target as HTMLElement).dataset.clip!;
					en.isIntersecting ? enter(key) : leave(key);
				}),
			{ rootMargin: "-40% 0px -40% 0px" },
		);
		document.querySelectorAll(`[data-variant="${variant}"] [data-clip]`).forEach((a) => io.observe(a));
	};

	// ---- peek: one floating card that follows the cursor ----
	const float = document.querySelector<HTMLElement>(".peek-float")!;
	const card = (key: string) => float.querySelector(`[data-for="${key}"]`)!;
	const peekOn = (key: string) => {
		float.querySelectorAll(".on").forEach((c) => c.classList.remove("on"));
		card(key).classList.add("on");
		float.classList.add("on");
		play(card(key));
	};
	const peekOff = (key: string) => {
		float.classList.remove("on");
		card(key).classList.remove("on");
		stop(card(key));
	};
	hover(
		"peek",
		(key, e) => (peekOn(key), atCursor(float, e.clientX, e.clientY)),
		peekOff,
		(e) => atCursor(float, e.clientX, e.clientY),
	);

	// ---- chip: same card, anchored under the thumbnail instead of the cursor ----
	document.querySelectorAll<HTMLElement>("[data-chip]").forEach((chip) => {
		const key = chip.dataset.chip!;
		const open = () => (peekOn(key), under(float, chip.getBoundingClientRect()), chip.setAttribute("aria-expanded", "true"));
		const close = () => (peekOff(key), chip.setAttribute("aria-expanded", "false"));
		chip.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && open());
		chip.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && close());
		chip.addEventListener("click", (e) => {
			e.stopPropagation();
			chip.getAttribute("aria-expanded") === "true" ? close() : open();
		});
		document.addEventListener("click", () => chip.getAttribute("aria-expanded") === "true" && close());
		addEventListener("scroll", () => chip.getAttribute("aria-expanded") === "true" && close(), { passive: true });
	});

	// ---- ascii: draw the clip into a canvas as characters ----
	const ascii = document.querySelector<HTMLElement>(".ascii-float")!;
	const canvas = ascii.querySelector("canvas")!;
	const ctx = canvas.getContext("2d")!;
	const sample = document.createElement("canvas").getContext("2d", { willReadFrequently: true })!;
	const srcs: Record<string, string> = JSON.parse(ascii.dataset.clips!);
	const vids: Record<string, HTMLVideoElement> = {};
	const RAMP = " .'`,:;-~+=*o#%@";
	const COLS = 96, CW = 4, CH = 7;
	let current: HTMLVideoElement | null = null;
	let raf = 0;
	const draw = () => {
		const vid = current;
		if (!vid) return;
		if (vid.readyState >= 2) {
			const rows = Math.round(((COLS * vid.videoHeight) / vid.videoWidth) * (CW / CH));
			const dpr = devicePixelRatio || 1;
			if (canvas.height !== rows * CH * dpr) {
				canvas.width = COLS * CW * dpr;
				canvas.height = rows * CH * dpr;
				canvas.style.width = `${COLS * CW}px`;
				canvas.style.height = `${rows * CH}px`;
			}
			sample.canvas.width = COLS;
			sample.canvas.height = rows;
			sample.drawImage(vid, 0, 0, COLS, rows);
			const px = sample.getImageData(0, 0, COLS, rows).data;
			// stretch contrast per frame so dim footage still reads as shapes
			const lums = new Float32Array(COLS * rows);
			let lo = 1, hi = 0;
			for (let i = 0; i < lums.length; i++) {
				const l = (0.299 * px[i * 4] + 0.587 * px[i * 4 + 1] + 0.114 * px[i * 4 + 2]) / 255;
				lums[i] = l;
				if (l < lo) lo = l;
				if (l > hi) hi = l;
			}
			const span = Math.max(hi - lo, 0.15);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, COLS * CW, rows * CH);
			ctx.font = `bold ${CH}px ui-monospace, monospace`;
			ctx.textBaseline = "top";
			for (let y = 0; y < rows; y++)
				for (let x = 0; x < COLS; x++) {
					const i = y * COLS + x;
					const lum = (lums[i] - lo) / span;
					const ch = RAMP[Math.min(RAMP.length - 1, (lum * RAMP.length) | 0)];
					if (ch === " ") continue;
					// the clip's own colour, lifted so dark pixels stay visible on bg1
					const r = px[i * 4], g = px[i * 4 + 1], b = px[i * 4 + 2];
					ctx.fillStyle = `rgb(${80 + r * 0.7},${80 + g * 0.7},${70 + b * 0.7})`;
					ctx.globalAlpha = 0.35 + 0.65 * lum;
					ctx.fillText(ch, x * CW, y * CH);
				}
			ctx.globalAlpha = 1;
		}
		raf = requestAnimationFrame(draw);
	};
	hover(
		"ascii",
		(key, e) => {
			current = vids[key] ??= Object.assign(document.createElement("video"), {
				src: srcs[key],
				muted: true,
				loop: true,
				playsInline: true,
			});
			if (!calm) current.play().catch(() => {});
			ascii.classList.add("on");
			atCursor(ascii, e.clientX, e.clientY);
			cancelAnimationFrame(raf);
			draw();
		},
		() => {
			ascii.classList.remove("on");
			current?.pause();
			current = null;
			cancelAnimationFrame(raf);
		},
		(e) => atCursor(ascii, e.clientX, e.clientY),
	);

	// ---- backdrop ----
	const bd = (key: string) => document.querySelector<HTMLVideoElement>(`.backdrop [data-for="${key}"]`)!;
	const bdOn = (key: string) => {
		bd(key).classList.add("on");
		if (!calm) bd(key).play().catch(() => {});
	};
	const bdOff = (key: string) => {
		const v = bd(key);
		v.classList.remove("on");
		// let the fade finish before pausing
		setTimeout(() => !v.classList.contains("on") && v.pause(), 500);
	};
	hover("backdrop", bdOn, bdOff);
	scrolled("backdrop", bdOn, bdOff);

	// ---- theater ----
	document.querySelectorAll<HTMLElement>("[data-theater]").forEach((btn) => {
		const dlg = document.querySelector<HTMLDialogElement>(`dialog[data-for="${btn.dataset.theater}"]`)!;
		btn.addEventListener("click", () => (dlg.showModal(), play(dlg)));
	});
	document.querySelectorAll<HTMLDialogElement>("dialog.theater").forEach((dlg) => {
		// clicks on the dimmed backdrop land on the dialog itself
		dlg.addEventListener("click", (e) => e.target === dlg && dlg.close());
		dlg.addEventListener("close", () => stop(dlg));
	});

	// ---- monitor ----
	const mon = document.querySelector<HTMLElement>(".monitor")!;
	let monTimer = 0;
	const monOn = (key: string) => {
		clearTimeout(monTimer);
		mon.querySelectorAll("[data-for]").forEach((c) => {
			const on = (c as HTMLElement).dataset.for === key;
			c.classList.toggle("on", on);
			on ? play(c) : stop(c);
		});
		mon.classList.add("on");
	};
	// linger a moment so moving between links doesn't flicker it
	const monOff = () => {
		monTimer = window.setTimeout(() => (mon.classList.remove("on"), stop(mon)), 1200);
	};
	hover("monitor", monOn, monOff);
	scrolled("monitor", monOn, monOff);

	// ---- collections: everything visible plays, everything off screen (or in a hidden tab) pauses ----
	const autoplay = new IntersectionObserver((entries) =>
		entries.forEach((en) => {
			const vid = en.target as HTMLVideoElement;
			if (en.isIntersecting && !calm) vid.play().catch(() => {});
			else vid.pause();
		}),
	);
	document.querySelectorAll("[data-autoplay] video").forEach((vid) => {
		// preload="none" is right for hover clips, but these are meant to be seen right away
		(vid as HTMLVideoElement).preload = "metadata";
		autoplay.observe(vid);
	});

	// wall: live timecodes in the corner of each monitor
	document.querySelectorAll(".wall .reel-tile").forEach((tile) => {
		const vid = tile.querySelector("video");
		if (!vid) return;
		const tc = tile.querySelector("[data-timecode]")!;
		vid.addEventListener("timeupdate", () => {
			const t = Math.floor(vid.currentTime);
			tc.textContent = `00:${String(t).padStart(2, "0")}`;
		});
	});

	// click any tile to see it big
	const reelDlg = document.querySelector<HTMLDialogElement>("#reel-theater")!;
	document.querySelectorAll<HTMLElement>(".reel-tile").forEach((tile) =>
		tile.addEventListener("click", () => {
			const src = tile.querySelector<HTMLVideoElement | HTMLImageElement>("video, img")!;
			const big = src.cloneNode() as HTMLVideoElement | HTMLImageElement;
			big.removeAttribute("class");
			reelDlg.querySelector(".stage")!.replaceChildren(big);
			reelDlg.querySelector(".cap")!.textContent = tile.dataset.label ?? "";
			reelDlg.showModal();
			if (big instanceof HTMLVideoElement) {
				big.currentTime = (src as HTMLVideoElement).currentTime;
				play(reelDlg);
			}
		}),
	);
	reelDlg.addEventListener("click", (e) => e.target === reelDlg && reelDlg.close());
	reelDlg.addEventListener("close", () => reelDlg.querySelector(".stage")!.replaceChildren());

	// ---- bullet ----
	document.querySelectorAll(".bullet-li").forEach((li) => {
		li.addEventListener("pointerenter", (e) => (e as PointerEvent).pointerType === "mouse" && play(li));
		li.addEventListener("pointerleave", (e) => (e as PointerEvent).pointerType === "mouse" && stop(li));
		li.querySelector(".bullet")!.addEventListener("click", () => {
			const on = li.classList.toggle("on");
			on ? play(li) : stop(li);
		});
	});

	// ---- reveal ----
	document.querySelectorAll<HTMLElement>("[data-toggle]").forEach((btn) => {
		const panel = btn.parentElement!.querySelector(`.clip-panel[data-key="${btn.dataset.toggle}"]`)
			?? btn.closest("section")!.querySelector(`.clip-panel[data-key="${btn.dataset.toggle}"]`)!;
		btn.addEventListener("click", () => {
			const open = btn.getAttribute("aria-expanded") !== "true";
			btn.setAttribute("aria-expanded", String(open));
			panel.classList.toggle("open", open);
			open ? play(panel) : stop(panel);
		});
	});

	// ---- margin: play only while the row is hovered ----
	document.querySelectorAll(".margin-li").forEach((li) => {
		li.addEventListener("pointerenter", () => play(li));
		li.addEventListener("pointerleave", () => stop(li));
	});

	// ---- strip: hover to play on desktop, tap to toggle on touch ----
	document.querySelectorAll(".tile").forEach((t) => {
		t.addEventListener("pointerenter", (e) => (e as PointerEvent).pointerType === "mouse" && play(t));
		t.addEventListener("pointerleave", (e) => (e as PointerEvent).pointerType === "mouse" && stop(t));
		t.addEventListener("click", () => {
			const on = t.classList.toggle("on");
			on ? play(t) : stop(t);
		});
	});
</script>
